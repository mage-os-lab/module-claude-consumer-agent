<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use MageOS\AiShoppingAssistant\ViewModel\CartSection;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

$cartSection = $viewModels->require(CartSection::class);
?>
<button
    type="button"
    x-data="initAiAgentCartStrip"
    @click="expand"
    class="shrink-0 flex items-center gap-3 w-full text-left border-b border-container pb-3 mb-3"
>
    <template x-for="item in thumbs" :key="item.item_id">
        <img
            :src="item.product_image.src"
            :alt="item.product_name"
            class="w-10 h-10 rounded object-cover"
        >
    </template>
    <span class="text-sm" x-text="countLabel"></span>
    <span class="text-sm font-semibold" x-show="subtotalHtml" x-html="subtotalHtml"></span>
    <a
        href="<?= $escaper->escapeUrl($cartSection->checkoutUrl()) ?>"
        @click.stop
        class="btn btn-primary btn-sm ml-auto"
    >
        <?= $escaper->escapeHtml(__('Checkout')) ?>
    </a>
</button>
