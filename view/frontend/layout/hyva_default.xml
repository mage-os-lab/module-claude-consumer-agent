<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="aiagent.luma.root" remove="true"/>
        <referenceBlock name="aiagent.luma.launcher" remove="true"/>
        <referenceContainer name="cart-drawer.top">
            <block name="aiagent.drawer"
                   class="MageOS\AiShoppingAssistant\Block\Surface"
                   template="MageOS_AiShoppingAssistant::surface/drawer.phtml"
                   ifconfig="ai_integration/aiagent/general/enabled">
                <arguments>
                    <argument name="surface" xsi:type="string">side_cart</argument>
                </arguments>
                <block name="aiagent.drawer.cartstrip" as="cart_strip" template="MageOS_AiShoppingAssistant::surface/cart-strip.phtml"/>
                <block name="aiagent.drawer.start" as="start" template="MageOS_AiShoppingAssistant::surface/start.phtml"/>
                <block name="aiagent.drawer.transcript" as="transcript" template="MageOS_AiShoppingAssistant::surface/transcript.phtml"/>
                <block name="aiagent.drawer.composer" as="composer" template="MageOS_AiShoppingAssistant::surface/composer.phtml"/>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block name="aiagent.store"
                   class="Magento\Framework\View\Element\Template"
                   template="MageOS_AiShoppingAssistant::js/store.phtml"
                   ifconfig="ai_integration/aiagent/general/enabled">
                <arguments>
                    <argument name="view_model" xsi:type="object">MageOS\AiShoppingAssistant\ViewModel\Assistant</argument>
                </arguments>
            </block>
            <block name="aiagent.overlay"
                   class="MageOS\AiShoppingAssistant\Block\Surface"
                   template="MageOS_AiShoppingAssistant::surface/overlay.phtml"
                   ifconfig="ai_integration/aiagent/general/enabled">
                <arguments>
                    <argument name="surface" xsi:type="string">overlay</argument>
                </arguments>
                <block name="aiagent.overlay.cartline" as="cart_line" template="MageOS_AiShoppingAssistant::surface/cart-line.phtml"/>
                <block name="aiagent.overlay.start" as="start" template="MageOS_AiShoppingAssistant::surface/start.phtml"/>
                <block name="aiagent.overlay.transcript" as="transcript" template="MageOS_AiShoppingAssistant::surface/transcript.phtml"/>
                <block name="aiagent.overlay.composer" as="composer" template="MageOS_AiShoppingAssistant::surface/composer.phtml"/>
            </block>
            <block name="aiagent.launcher"
                   class="MageOS\AiShoppingAssistant\Block\Launcher"
                   template="MageOS_AiShoppingAssistant::surface/launcher.phtml"
                   ifconfig="ai_integration/aiagent/general/launcher_enabled"/>
            <block name="aiagent.cards"
                   class="MageOS\AiShoppingAssistant\Block\Cards"
                   template="MageOS_AiShoppingAssistant::cards/container.phtml"
                   ifconfig="ai_integration/aiagent/general/enabled">
                <block name="aiagent.card.products" template="MageOS_AiShoppingAssistant::cards/products.phtml"/>
                <block name="aiagent.card.comparison" template="MageOS_AiShoppingAssistant::cards/comparison.phtml"/>
                <block name="aiagent.card.order_status" template="MageOS_AiShoppingAssistant::cards/order-status.phtml"/>
                <block name="aiagent.card.checkout" template="MageOS_AiShoppingAssistant::cards/checkout.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
