    <preference for="MageOS\ClaudeConsumerAgent\Api\Backend\FulfillmentProviderInterface" type="MageOS\ClaudeConsumerAgent\Model\Backend\Provider\FulfillmentAggregator"/>
    <preference for="MageOS\ClaudeConsumerAgent\Api\Backend\PolicySourceInterface" type="MageOS\ClaudeConsumerAgent\Model\Backend\Provider\CmsPagePolicySource"/>
    <preference for="MageOS\ClaudeConsumerAgent\Api\Backend\StoreFactTitleResolverInterface" type="MageOS\ClaudeConsumerAgent\Model\Backend\Provider\StoreFactTitleResolver"/>
    <preference for="MageOS\ClaudeConsumerAgent\Api\Backend\OrderStatusMapperInterface" type="MageOS\ClaudeConsumerAgent\Model\Backend\Provider\OrderStatusMapper"/>
