    <preference for="MageOS\ClaudeConsumerAgent\Api\Backend\CategorySearchProviderInterface" type="MageOS\ClaudeConsumerAgent\Model\Backend\Provider\CategoryNameSearch"/>
    <preference for="MageOS\ClaudeConsumerAgent\Api\Backend\ProductOptionsProviderInterface" type="MageOS\ClaudeConsumerAgent\Model\Backend\Provider\CoreOptions"/>
